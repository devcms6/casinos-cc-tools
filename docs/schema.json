{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/didoivanov/casinos-cc-tools/docs/schema.json",
  "title": "Casinos.cc Tools profile",
  "type": "object",
  "required": [
    "schema",
    "casino"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "casino": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "currency"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "review_url": {
          "type": "string"
        },
        "review_post_id": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "brandfinder_analysis_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "wagering": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_bet": {
          "type": [
            "number",
            "null"
          ]
        },
        "days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "activate_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "excluded_methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "win_cap": {
          "type": "object",
          "properties": {
            "multiplier": {
              "type": [
                "number",
                "null"
              ]
            },
            "countries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "contribution_note": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "wagering_x"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "deposit",
                  "spins"
                ]
              },
              "match_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max_bonus": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "min_deposit": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "wagering_x": {
                "type": "number"
              },
              "wagering_base": {
                "enum": [
                  "deposit_bonus",
                  "bonus",
                  "deposit",
                  "winnings"
                ]
              },
              "extras": {
                "type": "string"
              },
              "extras_min_deposit": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "deposit"
                }
              }
            },
            "then": {
              "required": [
                "match_pct",
                "max_bonus"
              ]
            }
          }
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "default_time": {
          "type": "object",
          "properties": {
            "bank": {
              "type": "string"
            },
            "other": {
              "type": "string"
            }
          }
        },
        "sources": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "withdrawals"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "crypto",
                  "ewallet",
                  "bank",
                  "card",
                  "voucher",
                  "other"
                ]
              },
              "withdrawals": {
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "min_withdrawal": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "time": {
                "type": "string"
              },
              "fee": {
                "type": "string"
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "daily": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "weekly": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "monthly": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
